# Live Databricks wiring — copy to .env and fill in, then:
#   set -a && . ./.env && set +a && python3 -m uvicorn mmm_refresh.api:app
# Leave MMM_LIVE unset to run the offline demo.

MMM_LIVE=1

# --- Databricks SQL warehouse (the one the app connects to) ---
DATABRICKS_SERVER_HOSTNAME=adb-XXXXXXXXXXXX.XX.azuredatabricks.net
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/xxxxxxxxxxxxxxxx
DATABRICKS_TOKEN=dapiXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# per-env host/http overrides (optional): MMM_DBX_HOST_UAT=... MMM_DBX_HTTP_UAT=...

# --- Catalog/schema that holds secondary_modelling_* per environment ---
# The code builds table names as: <CATALOG>.secondary_modelling_<raw_data|processed_data|contribution|avm|processing_details>
# Set the exact per-env value (include the env token wherever it belongs, e.g. a _uat suffix or a 3-level catalog.schema).
MMM_CATALOG_DEV=eki_refined_db
MMM_CATALOG_UAT=eki_refined_db          # <-- replace with the real UAT catalog/schema
MMM_CATALOG_PROD=eki_refined_db         # <-- replace with the real PROD catalog/schema

# --- ADLS base path per environment (for baseline + outputs) ---
MMM_ADLS_BASE_DEV=dbfs:/mnt/mmmgen2devdatalake/Users_MMM/Harshit_Test
MMM_ADLS_BASE_UAT=                      # <-- real UAT ADLS base (abfss://... or dbfs:/mnt/...)
MMM_ADLS_BASE_PROD=                     # <-- real PROD ADLS base

# --- where baseline Excel files are read/written ---
# Local path, or an ADLS-mounted path reachable from where the app runs.
MMM_BASELINE_DIR=./baselines
